{
  "name": "reaction-balancer",
  "version": "1.2.0",
  "description": "Persian chemical reaction balancing desktop app",
  "main": "desktop/main.js",
  "author": "Green Star",
  "license": "UNLICENSED",
  "scripts": {
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.greenstar.reactionbalancer",
    "productName": "Reaction Balancer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "app/src/main/assets/index.html",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Reaction-Balancer-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}